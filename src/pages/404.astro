---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist." noindex>
  <section class="section notfound">
    <div class="container container--narrow">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page</h1>
      <p class="lead">
        The page may have moved or never existed. Let's get you back on track.
      </p>
      <div class="notfound__actions">
        <Button href="/" variant="primary" size="lg">Back to home</Button>
        <Button href="/product/" variant="secondary" size="lg">Explore the product</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-9);
  }
  .notfound h1 {
    margin-block: var(--space-3);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>

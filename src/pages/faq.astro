---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';

const faqs = (await getCollection('faqs')).sort(
  (a, b) => a.data.order - b.data.order
);

const description =
  'Answers to common questions about InfoSof pricing, OpenTelemetry support, migration, data security, and support.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.data.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQ"
  description={description}
  canonical="/faq/"
  schema={faqSchema}
>
  <section class="section page-hero">
    <div class="container container--narrow">
      <span class="eyebrow">FAQ</span>
      <h1>Frequently asked questions</h1>
      <p class="lead">
        Everything you need to know about InfoSof. Can't find an answer?
        <a href="/contact/">Get in touch</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container container--narrow">
      <h2 id="faq-heading" class="visually-hidden">All questions</h2>
      <FaqList items={faqs.map((f) => f.data)} />
    </div>
  </section>

  <CtaBand
    title="Still have questions?"
    text="Our team is happy to walk you through InfoSof and your specific setup."
  />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-6);
    background-image: radial-gradient(
      70% 60% at 15% -10%,
      rgba(53, 214, 165, 0.1),
      transparent 60%
    );
  }
  .page-hero h1 {
    margin-block: var(--space-3);
  }
</style>

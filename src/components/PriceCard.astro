---
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  name: string;
  price: number;
  priceUnit: string;
  currency: string;
  tagline: string;
  features: string[];
  cta: { label: string; href: string };
  highlighted?: boolean;
}
const { name, price, priceUnit, currency, tagline, features, cta, highlighted } =
  Astro.props;

const isCustom = priceUnit === 'custom';
const symbol = currency === 'USD' ? '$' : '';
const displayPrice = isCustom ? 'Custom' : `${symbol}${price}`;
---

<article class={`price-card${highlighted ? ' price-card--featured' : ''}`}>
  {highlighted && <span class="price-card__flag">Most popular</span>}
  <h3 class="price-card__name">{name}</h3>
  <p class="price-card__price">
    <span class="price-card__amount">{displayPrice}</span>
    {!isCustom && <span class="price-card__unit">{priceUnit}</span>}
  </p>
  <p class="muted price-card__tagline">{tagline}</p>
  <Button href={cta.href} variant={highlighted ? 'primary' : 'secondary'} size="lg" class="price-card__cta">
    {cta.label}
  </Button>
  <ul class="price-card__features">
    {
      features.map((f) => (
        <li>
          <Icon name="check" size={18} />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    height: 100%;
    box-shadow: var(--shadow-sm);
  }
  .price-card--featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), var(--shadow);
    position: relative;
  }
  .price-card__flag {
    position: absolute;
    top: -0.75rem;
    left: var(--space-6);
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-full);
  }
  .price-card__name {
    font-size: var(--text-xl);
  }
  .price-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .price-card__amount {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .price-card__unit {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .price-card__tagline {
    margin-top: var(--space-2);
    min-height: 2.8em;
  }
  .price-card__cta {
    width: 100%;
    margin-block: var(--space-4);
  }
  .price-card__features {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .price-card__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .price-card__features :global(svg) {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>

---
import { site } from '@/config/site';

interface Props {
  href?: string | null;
}
const { href = '/' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class="logo" {...href ? { href, 'aria-label': `${site.name} home` } : {}}>
  <svg class="logo__mark" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
    <defs>
      <linearGradient id="logo-grad" x1="0" y1="0" x2="26" y2="26" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#4f46e5"></stop>
        <stop offset="1" stop-color="#9333ea"></stop>
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="24" height="24" rx="7" fill="url(#logo-grad)" opacity="0.12"></rect>
    <rect x="1" y="1" width="24" height="24" rx="7" fill="none" stroke="url(#logo-grad)" stroke-width="1.5" opacity="0.4"></rect>
    <path d="M4 16.5 L9 16.5 L11.5 9 L14.5 20 L17 13 L22 13" fill="none" stroke="url(#logo-grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="logo__word">{site.name}</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }
  .logo:hover {
    color: var(--text);
  }
  .logo__mark {
    color: var(--accent);
    flex-shrink: 0;
  }
</style>
